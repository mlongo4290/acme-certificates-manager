# Copy this file to .env.docker and fill in the values before running docker-compose

# REQUIRED: Security keys (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-with-openssl-rand-base64-32
ENCRYPTION_KEY=change-me-32-chars-exactly-here!!

# REQUIRED: Frontend URL (used for OAuth callbacks and password reset links)
FRONTEND_URL=http://localhost

# Optional: SMTP for password reset emails
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=your-email@gmail.com
#SMTP_PASS=your-app-password
#SMTP_FROM=ACME Manager <your-email@gmail.com>
SMTP_FROM_NAME=ACME Certificates Manager

# Optional: Logging
LOG_LEVEL=info
ENABLE_CONSOLE_LOGS=true
ENABLE_FILE_LOGS=true
LOG_DIR=/app/logs
LOG_MAX_FILES=14d

# Optional: Activity log
ACTIVITY_LOG_ENABLED=true
ACTIVITY_LOG_RETENTION_DAYS=90

# Optional: Renewal settings
RENEWAL_MAX_RETRIES=3
RENEWAL_RETRY_BASE_DELAY_MINUTES=30
