{
    "name": "acme-certificates-manager-backend",
    "version": "1.1.0",
    "description": "Backend for ACME Certificates Manager",
    "license": "AGPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "https://github.com/mlongo4290/acme-certificates-manager.git"
    },
    "main": "src/server.js",
    "scripts": {
        "start": "pm2 start ecosystem.config.js",
        "stop": "pm2 stop acm-backend",
        "restart": "pm2 restart acm-backend",
        "debug": "ts-node-dev --respawn --transpile-only --inspect=0.0.0.0:9229 src/server.ts --watch",
        "build": "tsc && npm run copy-templates",
        "copy-templates": "node -e \"require('fs').cpSync('src/templates', 'dist/templates', {recursive: true})\"",
        "seed": "ts-node src/seed.ts",
        "generate-keys": "node ../scripts/generate-keys.js"
    },
    "dependencies": {
        "@node-saml/passport-saml": "^5.1.0",
        "@peculiar/acme-client": "^1.8.2",
        "@peculiar/webcrypto": "^1.5.0",
        "@peculiar/x509": "^1.14.0",
        "@types/adm-zip": "^0.5.7",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/passport": "^1.0.17",
        "@types/passport-local": "^1.0.38",
        "@types/passport-oauth2": "^1.8.0",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "adm-zip": "^0.5.16",
        "agenda": "^5.0.0",
        "archiver": "^7.0.1",
        "axios": "^1.13.2",
        "bcryptjs": "^3.0.2",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "express-async-handler": "^1.2.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "ldap-authentication": "^3.3.6",
        "mjml": "^4.17.0",
        "mongoose": "^8.19.2",
        "multer": "^2.0.2",
        "nodemailer": "^7.0.10",
        "passport": "^0.7.0",
        "passport-custom": "^1.1.1",
        "passport-local": "^1.0.0",
        "passport-oauth2": "^1.8.0",
        "passport-openidconnect": "^0.1.2",
        "qrcode": "^1.5.4",
        "speakeasy": "^2.0.0",
        "sshpk": "^1.18.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.18.3",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@types/archiver": "^7.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/mjml": "^4.7.4",
        "@types/node": "^24.9.2",
        "@types/nodemailer": "^7.0.3",
        "@types/passport-openidconnect": "^0.1.3",
        "@types/passport-saml": "^1.1.7",
        "@types/qrcode": "^1.5.6",
        "@types/speakeasy": "^2.0.10",
        "@types/sshpk": "^1.17.4",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3"
    }
}