<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" color="#F45E43">Emissione del certificato fallita</mj-text>

        <mj-divider border-color="#F45E43"></mj-divider>

        <mj-text>Ciao,</mj-text>
        <mj-text>L'emissione di un nuovo certificato SSL/TLS per <strong>{{domain}}</strong> è fallita.</mj-text>

        <mj-text>
          <p><strong>Dominio:</strong> {{domain}}</p>
          <p><strong>ID certificato:</strong> {{certificateId}}</p>
          <p><strong>Errore:</strong> {{error}}</p>
        </mj-text>

        <mj-text><strong>Azione richiesta:</strong> Si prega di verificare la configurazione del certificato e le impostazioni DNS, quindi riprovare il processo di emissione.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text font-size="12px" color="#888888"> ACM Certificates Manager</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
