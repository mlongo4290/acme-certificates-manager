<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" color="#0fbc09">Script post emissione eseguito con successo</mj-text>

        <mj-divider border-color="#0fbc09"></mj-divider>

        <mj-text>Ciao,</mj-text>
        <mj-text>Lo script post emissione <strong>"{{scriptName}}"</strong> è stato eseguito con successo per il certificato <strong>{{domain}}</strong>.</mj-text>

        <mj-text>
          <p><strong>Script:</strong> {{scriptName}}</p>
          <p><strong>Dominio:</strong> {{domain}}</p>
          <p><strong>ID certificato:</strong> {{certificateId}}</p>
          <p>Lo script è stato completato senza errori.</p>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text font-size="12px" color="#888888"> ACM Certificates Manager</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
