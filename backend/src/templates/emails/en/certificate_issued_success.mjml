<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" color="#0fbc09">Certificate Issued Successfully</mj-text>

        <mj-divider border-color="#0fbc09"></mj-divider>

        <mj-text>Hello,</mj-text>
        <mj-text>A new SSL/TLS certificate has been successfully issued for <strong>{{domain}}</strong>.</mj-text>

        <mj-text>
          <p><strong>Domain:</strong> {{domain}}</p>
          <p><strong>Certificate ID:</strong> {{certificateId}}</p>
          <p><strong>Expiry Date:</strong> {{expiryDate}}</p>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text font-size="12px" color="#888888"> ACM Certificates Manager</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
