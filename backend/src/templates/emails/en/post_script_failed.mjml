<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" color="#F45E43">Post-Issue Script Failed</mj-text>

        <mj-divider border-color="#F45E43"></mj-divider>

        <mj-text>Hello,</mj-text>
        <mj-text>The post-issue script <strong>"{{scriptName}}"</strong> failed during execution for certificate <strong>{{domain}}</strong>.</mj-text>

        <mj-text>
          <p><strong>Script:</strong> {{scriptName}}</p>
          <p><strong>Domain:</strong> {{domain}}</p>
          <p><strong>Certificate ID:</strong> {{certificateId}}</p>
          <p><strong>Error:</strong> {{error}}</p>
        </mj-text>

        <mj-text><strong>Action Required:</strong> Please check the script logs and configuration.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text font-size="12px" color="#888888"> ACM Certificates Manager</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
