<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" color="#2196f3">Password Reset Request</mj-text>

        <mj-divider border-color="#2196f3"></mj-divider>

        <mj-text>Hello {{username}},</mj-text>
        <mj-text>You have requested to reset your password for ACME Certificates Manager.</mj-text>
        <mj-text>Click the button below to reset your password:</mj-text>
        <mj-button href="{{resetUrl}}" background-color="#2196f3" color="white"> Reset Password </mj-button>
        <mj-text>Or copy and paste this link in your browser:</mj-text>
        <mj-text>{{resetUrl}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text>This link will expire in 1 hour.</mj-text>
        <mj-text>If you didn't request this password reset, please ignore this email.</mj-text>
        <mj-text font-size="12px" color="#888888"> ACME Certificates Manager</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
