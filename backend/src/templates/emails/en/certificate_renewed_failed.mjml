<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" color="#F45E43">Certificate Renewal Failed</mj-text>

        <mj-divider border-color="#F45E43"></mj-divider>

        <mj-text>Hello,</mj-text>
        <mj-text>The renewal of the SSL/TLS certificate for <strong>{{domain}}</strong> has failed.</mj-text>

        <mj-text>
          <p><strong>Domain:</strong> {{domain}}</p>
          <p><strong>Certificate ID:</strong> {{certificateId}}</p>
          <p><strong>Error:</strong> {{error}}</p>
        </mj-text>

        <mj-text><strong>Action Required:</strong> Please check the certificate configuration and retry the renewal process manually</mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text font-size="12px" color="#888888"> ACM Certificates Manager</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
