# Development Environment Configuration
# Copy this file to .env for local development

# Server Configuration
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/acme-certificates-manager

# Scripts folder
SCRIPTS_FOLDER=.

# JWT Configuration
JWT_SECRET=your-jwt-secret-for-development
JWT_EXPIRES_IN=24h

# ACME Configuration
ENCRYPTION_KEY=your-encryption-key-for-development

# ACME Key Configuration
# Account key type: RSA, ECDSA (ECDSA P-256 recommended for modern compatibility)
ACME_ACCOUNT_KEY_TYPE=RSA
ACME_ACCOUNT_KEY_SIZE=4096
# Certificate key type: RSA, ECDSA (RSA 4096 is industry standard for SSL/TLS)
ACME_CERT_KEY_TYPE=RSA
ACME_CERT_KEY_SIZE=4096

# Frontend URL (used for OAuth callbacks and password reset links)
FRONTEND_URL=http://localhost:4200

# SMTP Email Configuration (optional - for password reset emails)
#SMTP_HOST=
#SMTP_PORT=
#SMTP_SECURE=
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=acm@example.com
SMTP_FROM_NAME=ACME Certificates Manager

# Logging Configuration
LOG_LEVEL=debug
LOG_DIR=../logs
ENABLE_CONSOLE_LOGS=true
ENABLE_FILE_LOGS=false
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# Activity Log Configuration
ACTIVITY_LOG_ENABLED=true
ACTIVITY_LOG_RETENTION_DAYS=90
ACTIVITY_LOG_HOUSEKEEPING_SCHEDULE=0 2 * * *

# Renewal Scheduling - Blackout Windows
# Comma-separated list of START-END pairs (hours 0-23) during which renewals are not scheduled.
# Supports multiple ranges and cross-midnight ranges.
# Examples:
#   7-20          → no renewals from 07:00 to 20:00 (office hours)
#   7-20,22-23    → office hours + 22:00-23:00
#   22-6          → cross-midnight: 22:00 to 06:00
#RENEWAL_BLACKOUT_WINDOWS=7-20

# Renewal Retry Configuration
# Max number of retry attempts after a failed renewal (default: 3)
RENEWAL_MAX_RETRIES=3
# Base delay in minutes between retries - uses exponential backoff: base * 2^attempt (default: 30)
# Retry 1: 30min, Retry 2: 60min, Retry 3: 120min
RENEWAL_RETRY_BASE_DELAY_MINUTES=30
