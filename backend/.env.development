# Development Environment Configuration
# Copy this file to .env for local development

# Server Configuration
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/acme-certificates-manager

# Scripts folder
SCRIPTS_FOLDER=.

# JWT Configuration
JWT_SECRET=your-jwt-secret-for-development
JWT_EXPIRES_IN=24h

# ACME Configuration
ENCRYPTION_KEY=your-encryption-key-for-development

# ACME Key Configuration
# Account key type: RSA, ECDSA (ECDSA P-256 recommended for modern compatibility)
ACME_ACCOUNT_KEY_TYPE=RSA
ACME_ACCOUNT_KEY_SIZE=4096
# Certificate key type: RSA, ECDSA (RSA 4096 is industry standard for SSL/TLS)
ACME_CERT_KEY_TYPE=RSA
ACME_CERT_KEY_SIZE=4096

# Frontend URL (used for OAuth callbacks and password reset links)
FRONTEND_URL=http://localhost:4200

# SMTP Email Configuration (optional - for password reset emails)
#SMTP_HOST=
#SMTP_PORT=
#SMTP_SECURE=
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=acm@example.com
SMTP_FROM_NAME=ACME Certificates Manager

# Logging Configuration
LOG_LEVEL=debug
LOG_DIR=../logs
ENABLE_CONSOLE_LOGS=true
ENABLE_FILE_LOGS=false
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# Activity Log Configuration
ACTIVITY_LOG_ENABLED=true
ACTIVITY_LOG_RETENTION_DAYS=90
ACTIVITY_LOG_HOUSEKEEPING_SCHEDULE=0 2 * * *
